            "kind": "vendor"
          },
          "files": [],
          "action": "reference_to_video",
          "requestBody": {
            "payload": {
              "model": "minimax-h3",
              "prompt": "cat",
              "seconds": 4,
              "size": "1376x768",
              "images": [
                "https://example.com/ref.jpg"
              ]
            },
            "formFields": {
              "images": [
                "https://example.com/ref.jpg"
              ],
              "model": [
                "minimax-h3"
              ],
              "prompt": [
                "cat"
              ],
              "size": [
                "1280x720"
              ]
            }
          }
        }
      ],
      "expected": {
        "url": "https://xysnai.cn/v1/videos",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer fixture-key"
        },
        "bodyType": "multipart",
        "parts": [
          {
            "name": "images",
            "value": "https://example.com/ref.jpg"
          },
          {
            "name": "model",
            "value": "minimax-h3"
          },
          {
            "name": "prompt",
            "value": "cat"
          },
          {
            "name": "size",
            "value": "1376x768"
          },
          {
            "name": "seconds",
            "value": "4"
          }
        ],
        "rewriteModel": "minimax-h3"
      }
    },
