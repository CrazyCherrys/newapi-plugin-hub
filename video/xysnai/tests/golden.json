    {
      "name": "H3 multipart forwarding writes normalized size and inserts the default seconds",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "minimax-h3",
          "upstreamModel": "minimax-h3",
          "baseUrl": "https://xysnai.cn",
          "apiKey": "fixture-key",
